# ─────────────────────────────────────────────────────────────────────
# Pritech PMS — Git ignore rules
# ─────────────────────────────────────────────────────────────────────

# ─── Virtualenv ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Python bytecode / caches ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─── Django ──────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
logs/
*.log

# ─── Environment files ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Celery ──────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat-schedule.*
celerybeat-schedule*

# ─── Testing ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml

# ─── IDE / Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── Tailwind compiled output ────────────────────────────────────────
theme/static/css/dist/

# ─── Windows ─────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Local overrides ─────────────────────────────────────────────────
*.local